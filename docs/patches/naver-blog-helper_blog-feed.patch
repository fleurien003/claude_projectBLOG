+"""네이버 블로그 RSS 최근 글 목록.
+
+대시보드가 발행 글을 카드와 자동으로 맞추려면 "최근에 블로그에 실제로 올라간 글"의
+제목·주소·발행 시각이 필요하다. 클라우드 세션은 네이버 도메인이 막혀 있어서 이 서버가 대신 가져온다.
+FastAPI 에 의존하지 않게 따로 뒀다 (테스트가 쉽다).
+"""
+import re
+import time
+import datetime
+import xml.etree.ElementTree as ET
+from email.utils import parsedate_to_datetime
+from typing import Any, Dict
+
+import requests
+
+_CACHE: Dict[str, Any] = {}
+_TTL = 300  # 5분
+
+
+def _parse_items(xml_bytes: bytes) -> list:
+    root = ET.fromstring(xml_bytes)
+    items = []
+    for it in root.iter("item"):
+        title = (it.findtext("title") or "").strip()
+        link = (it.findtext("link") or "").strip().split("?")[0]
+        pub = (it.findtext("pubDate") or "").strip()
+        ts, iso = None, ""
+        if pub:
+            try:
+                dt = parsedate_to_datetime(pub)
+                ts = int(dt.timestamp() * 1000)
+                iso = dt.astimezone(datetime.timezone(datetime.timedelta(hours=9))).isoformat()
+            except Exception:
+                pass
+        if title and link:
+            items.append({"title": title, "link": link, "published": iso, "ts": ts})
+    return items
+
+
+def get_blog_feed(blog_id: str = "fleurien003", limit: int = 50, fetch=requests.get) -> Dict[str, Any]:
+    """rss.blog.naver.com/<블로그ID>.xml 의 최근 글을 돌려준다. 실패하면 {"error": ...}."""
+    bid = re.sub(r"[^A-Za-z0-9_-]", "", blog_id or "")
+    if not bid:
+        return {"error": "blog_id 가 비어 있습니다."}
+    limit = min(max(int(limit or 50), 1), 50)
+    now = time.time()
+    hit = _CACHE.get(bid)
+    if hit and now - hit["at"] < _TTL:
+        items = hit["items"]
+    else:
+        try:
+            r = fetch(f"https://rss.blog.naver.com/{bid}.xml", timeout=10,
+                      headers={"User-Agent": "Mozilla/5.0"})
+        except Exception as e:
+            return {"error": f"RSS 요청 실패: {type(e).__name__}"}
+        if r.status_code != 200:
+            return {"error": f"RSS 응답 {r.status_code}"}
+        try:
+            items = _parse_items(r.content)
+        except ET.ParseError:
+            return {"error": "RSS 를 읽지 못했습니다."}
+        _CACHE[bid] = {"at": now, "items": items}
+    return {"blog_id": bid, "count": len(items[:limit]), "items": items[:limit],
+            "fetched_at": datetime.datetime.utcnow().isoformat() + "Z"}
