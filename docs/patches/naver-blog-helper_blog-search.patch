+# -------------------------------------------------------------
+# 블로그 검색 — 네이버 API HUB 블로그 검색(search/blog)
+#
+# 대시보드가 MCP 로 불러 쓴다. 호출은 이 서버가 하고 Claude 토큰은 들지 않는다.
+# 결과는 제목·요약(앞부분)·주소뿐이라 본문이 필요하면 blog_read 로 읽는다
+# (blog.naver.com 주소만 읽힌다 — readable 로 표시).
+# postdate 는 네이버가 주는 YYYYMMDD 그대로.
+# -------------------------------------------------------------
+def _blog_search_impl(query: str, display: int = 10, sort: str = "sim") -> Dict[str, Any]:
+    if sort not in ("date", "sim"):
+        sort = "sim"
+    display = min(max(display, 1), 30)
+
+    res, info = naver_api("search/blog", params={"query": query, "display": display, "sort": sort})
+    if res is None:
+        return {"error": "블로그 검색 실패", "tried": info}
+
+    data = res.json()
+    from urllib.parse import urlparse
+
+    items = []
+    for it in data.get("items", []):
+        link = it.get("link") or ""
+        host = urlparse(link).netloc.replace("www.", "")
+        items.append({
+            "title": _strip(it.get("title", "")),
+            "description": _strip(it.get("description", "")),
+            "link": link,
+            "blogger": _strip(it.get("bloggername", "")),
+            "postdate": it.get("postdate", ""),
+            "readable": host in ("blog.naver.com", "m.blog.naver.com"),
+        })
+
+    return {"query": query, "total": data.get("total", 0), "items": items}
+
+
+@app.get("/blog-search", dependencies=[Depends(rate_guard)])
+def blog_search_route(query: str, display: int = 10, sort: str = "sim"):
+    """네이버 블로그 검색. 제목·요약·주소·작성자·작성일을 돌려준다.
+
+    query: 검색어.
+    sort: sim(정확도순, 기본) 또는 date(최신순).
+    display: 1~30 (기본 10).
+    """
+    return _blog_search_impl(query=query, display=display, sort=sort)
+
+
